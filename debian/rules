#!/usr/bin/make -f
#
# This debian/rules uses debhelper.
#

# The scripts use Vyatta::VrfManager as in DANOS; as there, the image
# provides it (libvyatta-vrfmanager-perl, through the routing-instance
# packages). Ubuntu builds have no VRF kernel (linux-image-vrf), so there the
# module is optional and the scripts fall back to the default VRF without it.
ifeq ($(shell dpkg-vendor --derives-from Ubuntu && echo yes),yes)
override_dh_install:
	dh_install
	patch -p1 -F0 --no-backup-if-mismatch -d debian/vyatta-service-ssh \
		< debian/ubuntu/vrfmanager-optional.diff
endif

override_dh_systemd_start:
	dh_systemd_start --no-start \
	    debian/sshd@.service

%:
	dh $@ --with=systemd --with=yang
